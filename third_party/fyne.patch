@@ -0,0 +1,144 @@
+//go:build go1.24
+
+package container_test
+
+import (
+	"image"
+	"image/color"
+	"testing"
+
+	"fyne.io/fyne/v2"
+	"fyne.io/fyne/v2/canvas"
