+func (w *window) Maximized() bool {
+	if v := w.view(); v != nil {
+		return v.GetAttrib(glfw.Maximized) == glfw.True
+	}
+	return false
+}
+
+func (w *window) Maximize() {
+	w.runOnMainWhenCreated(func() {
+		w.viewport.Maximize()
+	})
+}
+
+func (w *window) Position() (int, int) {
+	if v := w.view(); v != nil {
+		return v.GetPos()
+	}
+	return 0, 0
+}

